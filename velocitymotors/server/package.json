{
  "name": "velocitymotors-server",
  "version": "1.0.0",
  "description": "Backend API for the VelocityMotors vehicle marketplace application",
  "main": "server.js",
  "scripts": {
    "wipe": "mocha ./tests/database.refresh.js --reporter spec --log-level=warn --timeout 10000",
    "test": "mocha ./tests/test.*.js --reporter spec --log-level=warn --timeout 10000",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "velocitymotors",
    "vehicles",
    "cars",
    "marketplace",
    "automotive",
    "api",
    "express",
    "sqlite"
  ],
  "author": "Armel Bissaka",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "chai": "^4.3.8",
    "chai-http": "^4.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "joi": "^17.10.2",
    "leo-profanity": "^1.8.0",
    "morgan": "^1.10.0",
    "nodemon": "^3.0.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "mocha": "^11.3.0"
  },
  "overrides": {
  "serialize-javascript": "7.0.5"
  }
}
